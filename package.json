{
  "name": "garita",
  "version": "0.1.0",
  "private": true,
  "description": "Garita: a live digital twin of Puerto Rico for housing recovery and disaster response",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5280",
    "build": "vite build",
    "preview": "vite preview --port 5281",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "seed": "node pipeline/derive.mjs site && node src/ontology/build-seed.ts site/data/seed site/data/twin.db",
    "deploy": "tools/deploy.sh"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.0.0",
    "@fontsource/ibm-plex-mono": "^5.0.0",
    "@preact/signals": "^2.0.0",
    "@sqlite.org/sqlite-wasm": "^3.50.0-build1",
    "@takram/three-atmosphere": "0.19.1",
    "@takram/three-clouds": "0.7.6",
    "@takram/three-geospatial": "0.9.1",
    "d3-force": "^3.0.0",
    "earcut": "^3.0.0",
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "preact": "^10.24.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "playwright-core": "^1.48.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}

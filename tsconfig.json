{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "jsx": "react-jsx", "jsxImportSource": "preact", "strict": false, "noImplicitAny": false, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "noEmit": true, "resolveJsonModule": true, "isolatedModules": true, "types": ["vite/client"]
  },
  "include": ["src", "pipeline", "tests"]
}
